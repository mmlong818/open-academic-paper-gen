# PostgreSQL
POSTGRES_DB=papergen
POSTGRES_USER=papergen
POSTGRES_PASSWORD=papergen_dev

# 应用数据库连接（asyncpg 格式）
DATABASE_URL=postgresql+asyncpg://papergen:papergen_dev@localhost:5558/papergen

# Redis（含认证密码）
REDIS_PASSWORD=redis_dev
REDIS_URL=redis://:redis_dev@localhost:6400/0

# OpenAI API Key
OPENAI_API_KEY=your_key_here

# 应用密钥 — 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_THIS_WITH_A_64_CHAR_HEX_SECRET

# 智谱 GLM（可选；fast 档优先使用，失败时降级到 OpenAI）
ZHIPU_API_KEY=

# 文献数据源（可选）
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Crossref / OpenAlex polite pool 联系邮箱；留空则不发送
CONTACT_EMAIL=
